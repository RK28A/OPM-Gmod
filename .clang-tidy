# Checks aimed at the defect classes the PR #64 review turned up: dangling
# references, format strings, bounds, ownership, RAII and C-style casts.
#
# The SDK headers are reverse-engineered vtable layouts and the ImGui/Font
# Awesome trees are vendored, so HeaderFilterRegex keeps the report to the code
# this project actually writes.
#
# misc-use-anonymous-namespace and bugprone-macro-parentheses are off because
# the TEST macro in tests/test_harness.h triggers both by construction: the
# self-registering pattern needs internal linkage, and `#name` cannot be
# parenthesised.  They fired on every test case and drowned the real report.
Checks: >
  -*,
  bugprone-branch-clone,
  bugprone-dangling-handle,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-macro-parentheses,
  bugprone-misplaced-widening-cast,
  bugprone-not-null-terminated-result,
  bugprone-signed-char-misuse,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-suspicious-memory-comparison,
  bugprone-suspicious-string-compare,
  bugprone-too-small-loop-variable,
  bugprone-undefined-memory-manipulation,
  bugprone-unhandled-self-assignment,
  bugprone-use-after-move,
  cert-err33-c,
  clang-analyzer-core.*,
  clang-analyzer-cplusplus.*,
  clang-analyzer-security.*,
  clang-analyzer-unix.Malloc,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-unused-parameters,
  misc-use-anonymous-namespace,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  readability-braces-around-statements,
  readability-misleading-indentation,
  readability-non-const-parameter,
  -performance-avoid-endl,
  -performance-enum-size,
  -misc-use-anonymous-namespace,
  -bugprone-macro-parentheses

HeaderFilterRegex: '(GMod-SDK/(hacks|hooks|mathlib|core)/|GMod-SDK/globals\.hpp|GMod-SDK/ImGui/imgui-notify/(notify_core|imgui_notify)\.h|tests/)'

WarningsAsErrors: ''

FormatStyle: file
